{
  "name": "svgmap",
  "private": true,
  "version": "1.0.0",
  "description": "Turn OpenStreetMap data into clean, cut-ready SVG maps for laser engraving, pen plotting and print.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "clipper2-ts": "^2.0.1-18",
    "maplibre-gl": "^6.11.2",
    "opentype.js": "1.3.4",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
